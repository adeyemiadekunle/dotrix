# Copy to apps/backend/.env. Only API/worker/migrations read this file.
# When present it replaces the legacy root .env; environment variables override it.
DOTRIX_ENV=development
DOTRIX_DATABASE_URL=postgresql+asyncpg://dotrix:change-me@127.0.0.1:5432/dotrix
DOTRIX_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
DOTRIX_REDIS_URL=redis://127.0.0.1:6379/0
DOTRIX_JOBS=local
DOTRIX_APP_URL=http://localhost:3000
DOTRIX_S3_ENDPOINT_URL=http://127.0.0.1:9000
DOTRIX_S3_ACCESS_KEY=dotrix
DOTRIX_S3_SECRET_KEY=change-me-at-least-8-chars
DOTRIX_S3_BUCKET=dotrix-documents
# Optional server-only integrations. Keep private keys out of client app env files.
# DOTRIX_GITHUB_CLIENT_ID=
# DOTRIX_GITHUB_CLIENT_SECRET=
# DOTRIX_GITHUB_APP_PRIVATE_KEY_PATH=/private/path/github-app.private-key.pem
# DOTRIX_ENCRYPTION_KEY=
# DOTRIX_SENDLY_API_KEY=

# Private SearXNG service shared by API and worker (JSON enabled).
DOTRIX_SEARCH_PROVIDER=searxng
DOTRIX_SEARXNG_URL=http://127.0.0.1:8081
# SEARXNG_SECRET belongs in the root infrastructure .env, not browser app files.
