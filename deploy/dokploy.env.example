# Paste into Dokploy's Environment tab for the compose service (deploy/docker-compose.dokploy.yml).
# Required values have no default; generate secrets with `openssl rand -hex 32`.

DOTRIX_APP_URL=https://dotrix.example.com
DOTRIX_VERSION=latest

POSTGRES_PASSWORD=
MINIO_ROOT_USER=dotrix
MINIO_ROOT_PASSWORD=
DOTRIX_JWT_SECRET=
# Encrypts model keys, saved coding sessions, and the like: keep it, or they can't be read again.
DOTRIX_ENCRYPTION_KEY=

# Email (Sendly): a live key, and a From address on your verified domain.
DOTRIX_SENDLY_API_KEY=
DOTRIX_EMAIL_FROM=dotrix <no-reply@example.com>

# The server's model keys (organisations and people can also add their own in Settings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# The GitHub App (sign-in, repositories, coding PRs). The private key inline: the PEM's lines
# joined with \n, or mount it as a file in Dokploy and set DOTRIX_GITHUB_APP_PRIVATE_KEY_PATH.
DOTRIX_GITHUB_APP_ID=
DOTRIX_GITHUB_APP_SLUG=
DOTRIX_GITHUB_APP_PRIVATE_KEY=
DOTRIX_GITHUB_WEBHOOK_SECRET=
DOTRIX_GITHUB_CLIENT_ID=
DOTRIX_GITHUB_CLIENT_SECRET=

# Coding runs. The GitHub organisation the app forks repos into, so a coding PR's CI never gets
# the repo's secrets. Set DOTRIX_CODING_SANDBOX=off to run without coding.
DOTRIX_CODING_FORK_OWNER=
DOTRIX_CODING_SANDBOX=docker
# Sized for 6 vCPUs / 12 GB: two runs at once, 3 GB and 2 CPUs each, one warm session.
DOTRIX_CODING_MAX_RUNS=2
DOTRIX_CODING_MEMORY=3g
DOTRIX_CODING_CPUS=2
DOTRIX_CODING_WARM_MAX=1
DOTRIX_CODING_IDLE_MINUTES=15
# gVisor, once runsc is installed and registered on the host (deploy/README.md).
DOTRIX_CODING_DOCKER_RUNTIME=

DOTRIX_TAVILY_API_KEY=
