# Paste into Dokploy's Environment tab for the compose service (deploy/docker-compose.dokploy.yml), then
# fill in every value marked REQUIRED. The compose file refuses to start without them, and the API refuses
# a production setting that isn't safe (core/settings.py `_safe_for_production`).
#
# Generate passwords, DOTRIX_JWT_SECRET, DOTRIX_ADMIN_BOOTSTRAP_TOKEN and SEARXNG_SECRET with:
#   openssl rand -hex 32
# DOTRIX_ENCRYPTION_KEY is a Fernet key, not a hex string (below).
#
# A blank value is the same as leaving the line out: the default applies.

# ---------------------------------------------------------------------------------------------------------
# The address and the release
# ---------------------------------------------------------------------------------------------------------

# REQUIRED. The web app's https:// address (the domain on the `web` service); also the GitHub App's
# callback and webhook base.
DOTRIX_APP_URL=https://app.dotrix.cc
# The image tag the build gives the backend and coding images.
DOTRIX_VERSION=latest

# ---------------------------------------------------------------------------------------------------------
# Building the images
# ---------------------------------------------------------------------------------------------------------

# REQUIRED. A GitHub classic personal access token with read:packages (only) that can read the
# kunemi-group organisation's packages. The backend image installs Chat's fx host (@kunemi-group/kai) and
# the coding image Kai's fx command (@kunemi-group/kai-cli-linux-<cpu>) from GitHub Packages with it, as a
# Docker build secret: it never reaches a running container or an image layer. Authorize it for the
# organisation's single sign-on if it has one.
KAI_PACKAGES_TOKEN=

# ---------------------------------------------------------------------------------------------------------
# Database, storage and secrets
# ---------------------------------------------------------------------------------------------------------

# REQUIRED. Postgres's password.
POSTGRES_PASSWORD=
# REQUIRED. The database as the API sees it: user dotrix with POSTGRES_PASSWORD, host postgres,
# port 5432, database dotrix.
DOTRIX_DATABASE_URL=postgresql+asyncpg://dotrix:<POSTGRES_PASSWORD>@postgres:5432/dotrix
# REQUIRED. Object storage (RustFS): its access key and secret, under the names MinIO used.
MINIO_ROOT_USER=dotrix
MINIO_ROOT_PASSWORD=
# REQUIRED. Signs sign-in tokens.
DOTRIX_JWT_SECRET=
# REQUIRED. Encrypts people's model keys, saved coding sessions and admins' two-factor secrets. Keep a copy
# somewhere safe: without it they can't be read again. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOTRIX_ENCRYPTION_KEY=
# REQUIRED. The private web search service's secret.
SEARXNG_SECRET=

# ---------------------------------------------------------------------------------------------------------
# Email (Sendly)
# ---------------------------------------------------------------------------------------------------------

# REQUIRED. A live key, and a From address on your verified domain. Production refuses to start without
# real email (the console backend would log sign-in links).
DOTRIX_SENDLY_API_KEY=
DOTRIX_EMAIL_FROM=dotrix <no-reply@dotrix.cc>

# ---------------------------------------------------------------------------------------------------------
# The GitHub App (sign-in, repositories, coding PRs, Juno's reviews)
# ---------------------------------------------------------------------------------------------------------

# Needed for GitHub sign-in and anything with code; without them, accounts, projects and documents still
# work. Permissions: Contents, Pull requests and Issues (write), Actions and Checks (read); events: Push,
# Pull request, Check suite. Callback and webhook URLs on DOTRIX_APP_URL (infra/coding/README.md).
DOTRIX_GITHUB_APP_ID=
DOTRIX_GITHUB_APP_SLUG=
DOTRIX_GITHUB_WEBHOOK_SECRET=
DOTRIX_GITHUB_CLIENT_ID=
DOTRIX_GITHUB_CLIENT_SECRET=
# The App's private key: inline, the PEM's lines joined with \n ...
DOTRIX_GITHUB_APP_PRIVATE_KEY=
# ... or a file you mount into the api and worker containers in Dokploy, by its path there.
# DOTRIX_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# ---------------------------------------------------------------------------------------------------------
# Coding (Kai)
# ---------------------------------------------------------------------------------------------------------

# REQUIRED unless DOTRIX_CODING_SANDBOX=off. The GitHub organisation the App forks repositories into, so a
# coding PR's CI never gets the repository's secrets.
DOTRIX_CODING_FORK_OWNER=
# Where Kai's turns run:
# - docker-cloud (recommended, deploy/README.md): Docker Cloud sandboxes, with the three values below.
# - docker (the compose file's default if this is left out): containers on this host's Docker, from the
#   coding image built here. Needs gVisor installed and registered first (deploy/README.md) and
#   DOTRIX_CODING_DOCKER_RUNTIME=runsc; there is no fallback to the ordinary runtime.
# - off: no coding.
DOTRIX_CODING_SANDBOX=docker-cloud
# REQUIRED for docker-cloud. The coding image in a registry: .github/workflows/coding-image.yml publishes
# it (it needs the repository secrets DOCKERHUB_USERNAME, DOCKERHUB_TOKEN and KAI_PACKAGES_TOKEN, and the
# variable CODING_IMAGE) and names its tag. And a Docker ID with a personal access token that has Cloud
# Sandboxes access. DOTRIX_CODING_CPUS picks the size (2 GiB per CPU).
DOTRIX_CODING_IMAGE=docker.io/<your-docker-id>/dotrix-coding:sha-<12-character-commit>
DOTRIX_DOCKER_CLOUD_ID=
DOTRIX_DOCKER_CLOUD_PAT=

# docker only (ignored by docker-cloud).
DOTRIX_CODING_DOCKER_RUNTIME=runsc
# Sized for 6 vCPUs / 12 GB: two turns at once, 3 GB and 2 CPUs each, one idle cached sandbox per workspace
# for 15 minutes. DOTRIX_CODING_MAX_RUNS must be positive.
DOTRIX_CODING_MAX_RUNS=2
DOTRIX_CODING_MEMORY=3g
DOTRIX_CODING_CPUS=2
DOTRIX_CODING_WARM_MAX=1
DOTRIX_CODING_IDLE_MINUTES=15
# Operator-approved image digests a project's environment may pick, preinstalled on each Docker worker; a
# JSON list.
DOTRIX_CODING_ENVIRONMENT_IMAGES=[]

# ---------------------------------------------------------------------------------------------------------
# The admin console and alerts
# ---------------------------------------------------------------------------------------------------------

# Needed once, to create the console's first owner (python -m dotrix_backend.admin_cli); remove it afterwards.
DOTRIX_ADMIN_BOOTSTRAP_TOKEN=
# The console's own address (the domain on the `admin` service), for the links in admin invite emails.
DOTRIX_ADMIN_URL=https://admin.dotrix.cc
DOTRIX_CLOUDFLARE_ANALYTICS_ACCOUNT_ID=
DOTRIX_CLOUDFLARE_ANALYTICS_SITE_TAG=
DOTRIX_CLOUDFLARE_ANALYTICS_API_TOKEN=
VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
# Who is emailed when dotrix needs attention, and when it clears (comma-separated; blank: the console's
# active owners), and how often the worker checks, in minutes (1 to 60).
DOTRIX_ALERT_EMAILS=
# DOTRIX_ALERT_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------------------------------------------
# Optional features (blank: the production default)
# ---------------------------------------------------------------------------------------------------------

# Uploads (documents and task attachments) one workspace may store, in MB; 0 is unlimited. Default 1024.
# Before the first deploy with it, check current use (deploy/README.md, Storage limit per workspace).
# DOTRIX_WORKSPACE_STORAGE_MB=1024
# Team workspaces. Default off; personal workspaces always work.
# DOTRIX_TEAMS=false
# Nova's run_script (several reads in one sandboxed step). Default off.
# DOTRIX_AGENT_SCRIPTS=false
# Specialists keep bounded context within each private conversation, on either chat runtime. Default off.
# DOTRIX_SPECIALIST_CONTINUITY=false

# Model providers are personal BYOK: each person connects their own key in Account → Your models. There is
# no server-wide model key or token budget to set here.
