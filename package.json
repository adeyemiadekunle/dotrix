{
  "name": "pmagent",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@pmagent/web",
    "dev:desktop": "turbo run dev --filter=@pmagent/desktop",
    "dev:backend": "uv run uvicorn pmagent_backend.main:app --reload --port 8000",
    "test:py": "uv run pytest"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}
