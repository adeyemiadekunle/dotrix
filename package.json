{
  "name": "dotrix",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && uv run ruff check apps packages",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter=@dotrix/web",
    "dev:desktop": "turbo run dev --filter=@dotrix/desktop",
    "dev:backend": "uv run python -m dotrix_backend.serve --reload --port 8000",
    "dev:worker": "uv run python -m dotrix_backend.worker",
    "test:py": "uv run pytest",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:migrate": "uv run --directory apps/backend alembic upgrade head",
    "db:revision": "uv run --directory apps/backend alembic revision --autogenerate -m",
    "openapi": "uv run python apps/backend/scripts/export_openapi.py && pnpm --filter @dotrix/api-client generate",
    "lint:fix": "eslint . --fix && uv run ruff check apps packages --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write",
    "*.py": "uv run ruff check --fix"
  }
}
