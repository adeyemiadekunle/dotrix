{
  "name": "@pmagent/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9 openapi-typescript openapi.json -o src/schema.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pmagent/shared": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
