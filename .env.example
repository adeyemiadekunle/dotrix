# Backend (apps/backend) — read with the PMAGENT_ prefix
PMAGENT_ENV=development
PMAGENT_DATABASE_URL=postgresql://pmagent:pmagent@localhost:5432/pmagent
PMAGENT_REDIS_URL=redis://localhost:6379/0

# Model providers (engine) — set at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web / desktop
NEXT_PUBLIC_API_URL=http://localhost:8000
PMAGENT_WEB_URL=http://localhost:3000
