# Copy to .env (git-ignored) and replace every "change-me". Never commit .env.

# Local services use 127.0.0.1, not localhost: Docker publishes them on IPv4 only, and on
# Windows "localhost" tries IPv6 first and stalls.

# Local Postgres (infra/docker-compose.yml, via `pnpm db:up`)
POSTGRES_USER=dotrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dotrix

# Local MinIO (S3-compatible) for document originals, via `pnpm db:up`
MINIO_ROOT_USER=dotrix
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Backend object storage. Locally this is MinIO; in production any S3-compatible store.
DOTRIX_S3_ENDPOINT_URL=http://127.0.0.1:9000
DOTRIX_S3_ACCESS_KEY=dotrix
DOTRIX_S3_SECRET_KEY=change-me-at-least-8-chars
DOTRIX_S3_BUCKET=dotrix-documents

# Backend (apps/backend), read with the DOTRIX_ prefix
DOTRIX_ENV=development
DOTRIX_DATABASE_URL=""
DOTRIX_REDIS_URL=redis://127.0.0.1:6379/0
# Where background work (agent runs, emails, password-reset requests) executes: "local" (tasks
# in the API process) or "worker" (queued in Redis; run `pnpm dev:worker` too). Worker mode
# keeps work going across API restarts and retries failed jobs.
DOTRIX_JOBS=local
# Outgoing email: "console" (logs it; development only) or "sendly" (https://developer.sendlyai.com).
# Unset: Sendly when its key is set. A sk_test_ key validates and logs but never delivers.
# DOTRIX_EMAIL_BACKEND=console
# DOTRIX_SENDLY_API_KEY=sk_test_change-me
# From address on a domain verified in Sendly; unset uses the account's default.
# DOTRIX_EMAIL_FROM="dotrix <no-reply@yourdomain.com>"
# Sign in with GitHub: a GitHub App (or OAuth App) with the callback URL
# http://localhost:3000/api/auth/github/callback (or http://localhost:8000/v1/auth/oauth/github/callback,
# which forwards there). A GitHub App needs Account permissions → Email addresses: read-only.
# Unset: the button isn't shown (the API says why at startup). GITHUB_CLIENT_ID / _SECRET, GITHUB_APP_CLIENT_ID / _SECRET
# and GITHUB_OAUTH_CLIENT_ID / _SECRET are read too.
# DOTRIX_GITHUB_CLIENT_ID=change-me
# DOTRIX_GITHUB_CLIENT_SECRET=change-me
# Only if the app has several callback URLs: the one to use.
# DOTRIX_GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Connecting projects' repos through the same GitHub App (see CLAUDE.md, agents v2 step 5, for its
# permissions, events, setup URL {web}/api/github/setup and webhook URL {api}/v1/github/webhook).
# DOTRIX_GITHUB_APP_ID=change-me
# DOTRIX_GITHUB_APP_SLUG=change-me
# DOTRIX_GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# DOTRIX_GITHUB_WEBHOOK_SECRET=change-me
# Connected repos are checked out here for agents to read (on the machine that runs agents:
# the worker, or the API in local mode), up to this size each.
# DOTRIX_CODE_DIR=~/.cache/dotrix/code
# DOTRIX_CODE_MAX_MB=500
# Coding runs ("Start coding" on an issue): Claude Code with ANTHROPIC_API_KEY, else Codex with
# OPENAI_API_KEY, in a sandbox; the platform pushes a branch and opens a PR through the GitHub
# App (Contents and Pull requests: write). "openshell" (setup: infra/coding/README.md), "local"
# (a temporary folder, no isolation: development only), or "off".
# DOTRIX_CODING_SANDBOX=off
# DOTRIX_CODING_IMAGE=dotrix-coding:latest
# DOTRIX_CODING_AGENT=auto
# DOTRIX_CODING_TIMEOUT_MINUTES=30
# DOTRIX_CODING_TOKEN_BUDGET=3000000
# Rate limits on sign-up, login, password reset, verification emails: "redis" (required in
# production), "memory" (one process), or "off".
DOTRIX_RATE_LIMITS=memory
# Peers whose X-Forwarded-For is believed (the web app's server, a load balancer).
# DOTRIX_TRUSTED_PROXIES=["127.0.0.1","::1"]
DOTRIX_LOG_JSON=true
# Tests default to DOTRIX_DATABASE_URL with database "dotrix_test"; each run creates its
# own copy of that name with a random suffix and drops it at the end. Uncomment to point
# them elsewhere:
# DOTRIX_TEST_DATABASE_URL=""

# Model for new projects' agents (provider:model). Needs that provider's key below.
DOTRIX_DEFAULT_MODEL=anthropic:claude-sonnet-5
# The most tokens one agent run may use (all its steps and specialists); a project can set its
# own in Settings. 0 turns the limit off.
# DOTRIX_RUN_TOKEN_BUDGET=500000
# Long conversations' older turns are summarised once the prompt passes this many tokens.
# DOTRIX_SUMMARIZE_AFTER_TOKENS=40000
# Search: the embedding model (google_genai or openai, using that provider's key below).
# Empty: search by keywords only.
# DOTRIX_EMBEDDING_MODEL=google_genai:gemini-embedding-001
# DOTRIX_EMBEDDING_MIN_SIMILARITY=0.6
# Research: web search through Tavily (https://tavily.com). Without a key, the model's built-in
# search is used and only pages the agent fetches become sources.
# DOTRIX_TAVILY_API_KEY=tvly-change-me

# Model providers: the server's own keys, lent to workspaces without one of their own (and the CLI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Organisations connect their own keys in Settings → Models, stored encrypted with this Fernet key
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Comma-separated to rotate: the first encrypts, every one decrypts.
# DOTRIX_ENCRYPTION_KEY=change-me
# A hosted service where everyone brings their own key: don't lend the server's keys above.
# DOTRIX_SERVER_MODEL_KEYS=false

# Web (apps/web) reads its own apps/web/.env.local, not this file. Vite serves the app and forwards
# /v1, /api, and /health to the API on the same origin (the session cookies stay first-party and
# the page never sees tokens); set this there if the API isn't on :8000:
# DOTRIX_API_URL=http://127.0.0.1:8000
# Desktop: the web app to open
DOTRIX_WEB_URL=http://localhost:3000
