# Copy to .env (git-ignored) and replace every "change-me". Never commit .env.

# Local services use 127.0.0.1, not localhost: Docker publishes them on IPv4 only, and on
# Windows "localhost" tries IPv6 first and stalls.

# Local Postgres (infra/docker-compose.yml, via `pnpm db:up`)
POSTGRES_USER=pmagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pmagent

# Local MinIO (S3-compatible) for document originals, via `pnpm db:up`
MINIO_ROOT_USER=pmagent
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Backend object storage. Locally this is MinIO; in production any S3-compatible store.
PMAGENT_S3_ENDPOINT_URL=http://127.0.0.1:9000
PMAGENT_S3_ACCESS_KEY=pmagent
PMAGENT_S3_SECRET_KEY=change-me-at-least-8-chars
PMAGENT_S3_BUCKET=pmagent-documents

# Backend (apps/backend), read with the PMAGENT_ prefix
PMAGENT_ENV=development
PMAGENT_DATABASE_URL=""
PMAGENT_REDIS_URL=redis://127.0.0.1:6379/0
# Where background work (agent runs, emails, password-reset requests) executes: "local" (tasks
# in the API process) or "worker" (queued in Redis; run `pnpm dev:worker` too). Worker mode
# keeps work going across API restarts and retries failed jobs.
PMAGENT_JOBS=local
# Rate limits on sign-up, login, password reset, verification emails: "redis" (required in
# production), "memory" (one process), or "off".
PMAGENT_RATE_LIMITS=memory
# Peers whose X-Forwarded-For is believed (the web app's server, a load balancer).
# PMAGENT_TRUSTED_PROXIES=["127.0.0.1","::1"]
PMAGENT_LOG_JSON=true
# Tests default to PMAGENT_DATABASE_URL with database "pmagent_test"; each run creates its
# own copy of that name with a random suffix and drops it at the end. Uncomment to point
# them elsewhere:
# PMAGENT_TEST_DATABASE_URL=""

# Model for new projects' agents (provider:model). Needs that provider's key below.
PMAGENT_DEFAULT_MODEL=anthropic:claude-sonnet-5

# Model providers (engine): set at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web (apps/web) reads its own apps/web/.env.local, not this file. Its server talks to the API
# (the browser never does, and never sees tokens); set this there if the API isn't on :8000:
# PMAGENT_API_URL=http://127.0.0.1:8000
# Desktop: the web app to open
PMAGENT_WEB_URL=http://localhost:3000
