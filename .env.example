# Copy to .env (git-ignored) and replace every "change-me". Never commit .env.

# Local Postgres (infra/docker-compose.yml, via `pnpm db:up`)
POSTGRES_USER=pmagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pmagent

# Local MinIO (S3-compatible) for document originals, via `pnpm db:up`
MINIO_ROOT_USER=pmagent
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# Backend object storage. Locally this is MinIO; in production any S3-compatible store.
PMAGENT_S3_ENDPOINT_URL=http://localhost:9000
PMAGENT_S3_ACCESS_KEY=pmagent
PMAGENT_S3_SECRET_KEY=change-me-at-least-8-chars
PMAGENT_S3_BUCKET=pmagent-documents

# Backend (apps/backend), read with the PMAGENT_ prefix
PMAGENT_ENV=development
PMAGENT_DATABASE_URL=""
PMAGENT_REDIS_URL=""
PMAGENT_LOG_JSON=true
# Tests default to PMAGENT_DATABASE_URL with database "pmagent_test" (dropped and
# recreated each run). Uncomment to point them elsewhere:
# PMAGENT_TEST_DATABASE_URL=""

# Model providers (engine): set at least one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web / desktop
NEXT_PUBLIC_API_URL=http://localhost:8000
PMAGENT_WEB_URL=http://localhost:3000
